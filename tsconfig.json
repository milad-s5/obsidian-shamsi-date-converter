{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist/",
    "rootDir": "src/",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "ES6",
    "module": "ESNext",
    "lib": ["DOM", "ES5", "ES6", "ES7"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
